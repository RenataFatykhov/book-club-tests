{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/Welcome1",
  "definitions": {
    "Welcome1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer"
        },
        "next": {
          "type": "string",
          "format": "uri",
          "qt-uri-protocols": [
            "http"
          ]
        },
        "previous": {
          "type": "null"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Result"
          }
        }
      },
      "required": [
        "count",
        "next",
        "previous",
        "results"
      ],
      "title": "Welcome1"
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "bookTitle": {
          "type": "string"
        },
        "bookAuthors": {
          "type": "string"
        },
        "publicationYear": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "telegramChatLink": {
          "type": "string",
          "format": "uri",
          "qt-uri-protocols": [
            "https"
          ]
        },
        "owner": {
          "type": "integer"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Review"
          }
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bookAuthors",
        "bookTitle",
        "created",
        "description",
        "id",
        "members",
        "modified",
        "owner",
        "publicationYear",
        "reviews",
        "telegramChatLink"
      ],
      "title": "Result"
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "club": {
          "type": "integer"
        },
        "user": {
          "$ref": "#/definitions/User"
        },
        "review": {
          "type": "string"
        },
        "assessment": {
          "type": "integer"
        },
        "readPages": {
          "type": "integer"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "type": "null"
        }
      },
      "required": [
        "assessment",
        "club",
        "created",
        "id",
        "modified",
        "readPages",
        "review",
        "user"
      ],
      "title": "Review"
    },
    "User": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "username"
      ],
      "title": "User"
    }
  }
}
