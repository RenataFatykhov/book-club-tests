{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/Review",
  "definitions": {
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "club": {
          "type": "integer"
        },
        "user": {
          "$ref": "#/definitions/User"
        },
        "review": {
          "type": "string"
        },
        "assessment": {
          "type": "integer"
        },
        "readPages": {
          "type": "integer"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assessment",
        "club",
        "created",
        "id",
        "modified",
        "readPages",
        "review",
        "user"
      ]
    },
    "User": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "username"
      ]
    }
  }
}
